# Server Configuration
PORT=8080

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/preporbit?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/preporbit

# Security & JWT Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=PrepOrbitSecretKeyForJwtAuthenticationTokensMustBeLongEnoughForSha256Security

# Allowed Frontend Origins (Comma separated for CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# AI Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
